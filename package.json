{
  "name": "kariyerweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "node --import ./tests/setup/register.mjs --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --import ./tests/setup/register.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=75 --test-coverage-branches=80 --test-coverage-functions=65 \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run size && npm audit --audit-level=high",
    "preview": "vite preview",
    "size": "node scripts/check-size.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=23.6"
  }
}
