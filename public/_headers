# Response headers for static hosts that read this file (Netlify, Cloudflare Pages).
# The page carries its own Content-Security-Policy; framing can only be refused here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# the service worker must always be checked for a new build
/sw.js
  Cache-Control: no-cache

# fingerprinted files never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable
